# Replace every change-me value before exposing this system to a network.
# Use URL-safe characters for POSTGRES_PASSWORD and REDIS_PASSWORD.

# Database Configuration
DATABASE_URL=postgresql://postgres:change-me-postgres-password@localhost:5432/medical_reports
POSTGRES_DB=medical_reports
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password

# Redis Configuration
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@localhost:6379

# JWT and Security
JWT_SECRET=change-me-jwt-secret
SESSION_SECRET=change-me-session-secret

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=medical-reports
KEYCLOAK_CLIENT_ID=medical-reports-api
KEYCLOAK_CLIENT_SECRET=change-me-keycloak-client-secret
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password

# Frontend Configuration
REACT_APP_API_URL=http://localhost:3000
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_KEYCLOAK_REALM=medical-reports
REACT_APP_KEYCLOAK_CLIENT_ID=medical-reports-client

# LLM Configuration
# Configure LLM providers in the Admin Panel. No defaults are set here.

# RAG Configuration (Optional)
RAG_API_URL=http://your-rag-service:8000
RAG_ENABLED=false

# PACS Configuration (Default)
DEFAULT_PACS_URL=http://your-pacs-server:8080
DEFAULT_PACS_AUTH_TYPE=none

# Application Settings
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,dcm

# Session Configuration
SESSION_TIMEOUT=1800000
