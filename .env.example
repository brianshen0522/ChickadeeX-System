# Host IP Configuration - Change these for different devices/deployments
PUBLIC_PROTOCOL=http
PUBLIC_HOSTNAME=localhost
KEYCLOAK_HTTP_PORT=80

# Core Host Aliases
HOST_IP=${PUBLIC_HOSTNAME}
KEYCLOAK_HOST_IP=${PUBLIC_HOSTNAME}
FRONTEND_HOST_IP=${PUBLIC_HOSTNAME}
DB_HOST_IP=db
REDIS_HOST_IP=redis

# Public service URLs
PUBLIC_BACKEND_URL=${PUBLIC_PROTOCOL}://${PUBLIC_HOSTNAME}
PUBLIC_FRONTEND_URL=${PUBLIC_PROTOCOL}://${PUBLIC_HOSTNAME}

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres123@${DB_HOST_IP}:5432/medical_reports
POSTGRES_DB=medical_reports
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# Redis Configuration
REDIS_URL=redis://:redis123@${REDIS_HOST_IP}:6379
REDIS_PASSWORD=redis123

# JWT and Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production-abc123XYZ789
SESSION_SECRET=your-super-secret-session-key-change-in-production-def456UVW012
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_MAX_AGE=

# Keycloak Configuration
KEYCLOAK_PUBLIC_URL=${PUBLIC_PROTOCOL}://${KEYCLOAK_HOST_IP}/kc
KEYCLOAK_FRONTEND_URL=${PUBLIC_PROTOCOL}://${PUBLIC_HOSTNAME}/kc
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_URL=${KEYCLOAK_PUBLIC_URL}
KEYCLOAK_REALM=medical-reports
KEYCLOAK_CLIENT_ID=medical-reports-client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_DB_SCHEMA=keycloak

# Frontend Configuration
REACT_APP_PUBLIC_PROTOCOL=${PUBLIC_PROTOCOL}
REACT_APP_PUBLIC_HOSTNAME=${PUBLIC_HOSTNAME}
REACT_APP_KEYCLOAK_PORT=${KEYCLOAK_HTTP_PORT}
REACT_APP_API_URL=${PUBLIC_BACKEND_URL}
REACT_APP_BLUELIGHT_BASE_URL=${PUBLIC_PROTOCOL}://${PUBLIC_HOSTNAME}/bluelight
REACT_APP_KEYCLOAK_URL=${KEYCLOAK_FRONTEND_URL}
REACT_APP_KEYCLOAK_REALM=medical-reports
REACT_APP_KEYCLOAK_CLIENT_ID=medical-reports-client

# LLM Configuration
# Configure LLM providers in the Admin Panel. No defaults are set here.

# RAG Configuration (Optional)
RAG_API_URL=${PUBLIC_BACKEND_URL}/rag
RAG_ENABLED=false

# PACS Configuration (Configure in Admin Panel or set defaults)
DEFAULT_PACS_URL=${KEYCLOAK_PUBLIC_URL}
DEFAULT_PACS_AUTH_TYPE=none

# Application Settings
NODE_ENV=production
PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=3001
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
DB_PORT=5432
REDIS_PORT=6379
CORS_ORIGIN=${PUBLIC_PROTOCOL}://${FRONTEND_HOST_IP}

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,dcm

# Session Configuration
SESSION_TIMEOUT=1800000

# Docker Configuration
DOCKER_PUID=1000
DOCKER_PGID=1000
DOCKER_TZ=Etc/UTC
