# Database Configuration
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/medical_reports
POSTGRES_DB=medical_reports
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# Redis Configuration
REDIS_URL=redis://:redis123@localhost:6379

# JWT and Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_SECRET=your-super-secret-session-key-change-in-production

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=medical-reports
KEYCLOAK_CLIENT_ID=medical-reports-api
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret

# Frontend Configuration
REACT_APP_API_URL=http://localhost:3000
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_KEYCLOAK_REALM=medical-reports
REACT_APP_KEYCLOAK_CLIENT_ID=medical-reports-client

# LLM Configuration
# Configure LLM providers in the Admin Panel. No defaults are set here.

# RAG Configuration (Optional)
RAG_API_URL=http://your-rag-service:8000
RAG_ENABLED=false

# PACS Configuration (Default)
DEFAULT_PACS_URL=http://your-pacs-server:8080
DEFAULT_PACS_AUTH_TYPE=none

# Application Settings
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,dcm

# Session Configuration
SESSION_TIMEOUT=1800000
